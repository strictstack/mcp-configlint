{
  "mcpServers": {
    "latest": {
      "command": "npx",
      "args": [
        "--yes",
        "example-mcp@latest"
      ]
    },
    "floating": {
      "command": "pnpm",
      "args": [
        "dlx",
        "example-mcp@^1.2.3"
      ]
    },
    "unpinned": {
      "command": "uvx",
      "args": [
        "example-mcp"
      ]
    }
  }
}
